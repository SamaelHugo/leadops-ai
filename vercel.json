{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "workspace": "frontend",
      "framework": "nextjs",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "backend/main.py",
      "routePrefix": "/backend",
      "maxDuration": 60,
      "includeFiles": [
        "backend/alembic.ini",
        "backend/migrations/**"
      ]
    }
  }
}
