# Copy this file to .env before starting Docker Compose.
# Replace every value marked "replace-me" outside a throwaway local demo.

POSTGRES_DB=leadops
POSTGRES_USER=leadops
POSTGRES_PASSWORD=replace-me-with-a-long-random-password

JWT_SECRET=replace-me-with-at-least-32-random-characters
# Optional. When empty, LeadOps derives the Fernet key from JWT_SECRET.
ENCRYPTION_KEY=

SEED_DEMO_DATA=true
LLM_PROVIDER=mock
EMBEDDINGS_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_DIM=384

NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

N8N_ENCRYPTION_KEY=replace-me-with-another-long-random-value
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

